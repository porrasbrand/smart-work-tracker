# Database
DB_PATH=./data/smart-work-tracker.db

# ActiveCollab (Phase 3A+)
AC_API_URL=https://app.activecollab.com/YOUR_INSTANCE_ID
AC_API_TOKEN=your_activecollab_api_token_here

# AI Provider (Phase 3B+)
AI_PROVIDER=none  # gemini|anthropic|openai|none
AI_ENABLED=false
# GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Privacy Settings
EXCLUDE_THINKING=false
EXTRACT_THINKING_SUMMARY=true
EXCLUDE_CODE=true
REDACT_SECRETS=true
REDACT_PII=true

# Attribution
IDLE_GAP_MINUTES=15
MIN_SESSION_MINUTES=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Phase 5: Review Interface API
API_PORT=3001
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
BILLING_RATE_DEFAULT=100
