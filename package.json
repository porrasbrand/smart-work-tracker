{
  "name": "smart-work-tracker",
  "version": "0.1.0",
  "description": "Automated work tracking system for Claude Code sessions with ActiveCollab integration",
  "main": "src/index.js",
  "bin": {
    "smart-work-tracker": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "migrate": "node src/index.js migrate",
    "migrate:down": "node src/index.js migrate down",
    "dev:api": "nodemon src/api/server.js",
    "dev:ui": "cd web-ui && npm run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\""
  },
  "keywords": [
    "claude-code",
    "activecollab",
    "time-tracking",
    "work-tracker",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^11.0.7",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.17.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
